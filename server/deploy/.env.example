# server/deploy/.env: settings for compose.cloudflare.yml (copy to .env; never commit it).
# The app's own settings (Discord, Drive, SMTP, Litestream…) go in dashboard.env.

# ── Cloudflare Tunnel ──────────────────────────────────────────────────────────────────
# The public origin officers and agents use: the tunnel's published hostname, https, no
# trailing slash. MCP lives at ${APP_URL}/mcp. It overrides APP_URL in dashboard.env.
APP_URL=https://officers.example.org

# The remotely managed tunnel's token: Cloudflare dashboard → Networking → Tunnels → your
# tunnel → (Configure / install) → the long value after `--token` in the install command.
# It lets anyone run your tunnel: keep it secret, rotate it there if it leaks.
TUNNEL_TOKEN=

# The private network between cloudflared and the dashboard, as its first three octets:
# subnet ${TUNNEL_NET}.0/28, containers in ${TUNNEL_NET}.8/29 (that range is also
# TRUSTED_PROXIES), gateway ${TUNNEL_NET}.1. Use a prefix nothing else uses; change it if
# compose reports that the pool overlaps.
#TUNNEL_NET=10.250.89

# Pinned cloudflared release (https://github.com/cloudflare/cloudflared/releases).
#CLOUDFLARED_VERSION=2026.10.0

# ── The dashboard image ────────────────────────────────────────────────────────────────
# Required: which published image to run, ghcr.io/cseed-org/officer-dashboard:${DASHBOARD_TAG}.
# Pin a fixed tag; it then changes only when you change it:
#   0.15.0         one release (git tag v0.15.0)
#   sha-1a2b3c4    one commit on main (7 characters: git rev-parse --short=7 <commit>), for
#                  before the first release tag exists
# The moving tags latest, 0.15 and main also exist, but with them any later `pull` (even one
# meant for cloudflared) upgrades the dashboard and migrates the database with no backup.
# Published tags: https://github.com/cseed-org/officer-dashboard/pkgs/container/officer-dashboard
# Upgrade: back up, change this, then `docker compose -f compose.cloudflare.yml pull` and `up -d`.
# Going back to an older tag after a newer one migrated the database needs a restore from
# backup first: migrations are forward-only (docs/deploy/upgrade-existing.md, Rollback).
# If the package is private, `docker login ghcr.io` once on this machine (docs/deployment.md).
DASHBOARD_TAG=0.15.0

# The whole image name instead, for an image you build from this checkout (compose.build.yml)
# or the copy of the old image an upgrade keeps. A local name is never pulled.
#DASHBOARD_IMAGE=officer-dashboard:local
