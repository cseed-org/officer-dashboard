# Template: replace <install-dir> in the command below; it fills in @INSTALL_DIR@.
# Render from this directory (quote paths containing spaces):
#   sed 's|@INSTALL_DIR@|<install-dir>|g' dashboard.service | sudo tee /etc/systemd/system/dashboard.service > /dev/null
# Raspberry Pi 5 (or any systemd Linux box).
#
#   sudo useradd --system --home /var/lib/officer-dashboard --shell /usr/sbin/nologin dashboard
#   sudo install -m 0755 bin/dashboard @INSTALL_DIR@/dashboard
#   sudo install -d -m 0750 -o root -g dashboard /etc/officer-dashboard
#   sudo install -m 0640 -g dashboard deploy/dashboard.env.example /etc/officer-dashboard/env   # then edit it
#   # Render the template with sed as shown above.
#   sudo systemctl daemon-reload && sudo systemctl enable --now dashboard
#   journalctl -u dashboard -f
[Unit]
Description=CSEED officer dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dashboard
Group=dashboard
EnvironmentFile=/etc/officer-dashboard/env
Environment=ADDR=127.0.0.1:8090
Environment=DB_PATH=/var/lib/officer-dashboard/dashboard.db
ExecStart="@INSTALL_DIR@/dashboard" serve
Restart=on-failure
RestartSec=2s
# SIGTERM gets 15 s (cmd/dashboard ShutdownBudget) to drain in-flight requests and let the
# calendar worker record what it is sending, then closes the database. Allow more than that.
TimeoutStopSec=30s

# State lives under /var/lib/officer-dashboard (created, owned and writable by the unit).
StateDirectory=officer-dashboard
StateDirectoryMode=0750

# Hardening: the server needs the network and its own state directory, nothing else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
