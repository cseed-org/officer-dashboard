# Template: replace <install-dir> in the command below; it fills in @INSTALL_DIR@.
# Render from this directory (quote paths containing spaces):
#   sed 's|@INSTALL_DIR@|<install-dir>|g' dashboard-backup.service | sudo tee /etc/systemd/system/dashboard-backup.service > /dev/null
[Unit]
Description=Back up the officer dashboard database

[Service]
Type=oneshot
User=dashboard
Group=dashboard
EnvironmentFile=/etc/officer-dashboard/env
Environment=DB_PATH=/var/lib/officer-dashboard/dashboard.db
Environment=BACKUP_DIR=/var/lib/officer-dashboard/backups
ExecStart="@INSTALL_DIR@/backup"
StateDirectory=officer-dashboard
StateDirectoryMode=0750
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
