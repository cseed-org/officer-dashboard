# Backup sidecar only. The app does not receive these settings or this secret directory.
BACKUP_SINK_URL=https://backups.example.org
BACKUP_AGE_RECIPIENT=age1...
# Bearer secret must be at least 32 bytes; generate 32 random bytes and encode them.
BACKUP_BEARER_SECRET_FILE=/run/secrets/backup/bearer
# Both Access service-token authentication and the strong bearer are required.
BACKUP_ACCESS_CLIENT_ID_FILE=/run/secrets/backup/access-client-id
BACKUP_ACCESS_CLIENT_SECRET_FILE=/run/secrets/backup/access-client-secret
# Weekly membership export (account-scoped D1 Edit token):
#BACKUP_MEMBERSHIP_ACCOUNT_ID=
#BACKUP_MEMBERSHIP_DATABASE_ID=
#BACKUP_MEMBERSHIP_API_TOKEN_FILE=/run/secrets/backup/membership-api-token
# Optional backup alerts; may contain a copy of the app's Discord webhook.
#DISCORD_WEBHOOK_URL_FILE=/run/secrets/backup/discord-webhook-url
