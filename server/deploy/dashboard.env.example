# The dashboard's own settings and secrets. With Docker (compose.cloudflare.yml) this file is
# server/deploy/dashboard.env; under systemd it is /etc/officer-dashboard/env (mode 0640).
# The binary resolves application _FILE credentials in memory for both entry points.
# Under systemd, replace /run/secrets/app paths with root-managed files readable by
# the service user (for example /etc/officer-dashboard/secrets/discord-client-secret).
# With Docker, compose sets APP_URL from server/deploy/.env and ignores the line below.
APP_URL=https://officers.cseed.co

# Discord OAuth2 app. Redirect URI: ${APP_URL}/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET_FILE=/run/secrets/app/discord-client-secret
# Initial dashboard owner, provisioned at server start only while no owner exists.
# Fill these in for deployment; ownership transfers override this configuration.
BOOTSTRAP_OWNER_DISCORD_ID=
BOOTSTRAP_OWNER_NAME=
# Deprecated ID alias (BOOTSTRAP_OWNER_DISCORD_ID takes precedence):
#BOOTSTRAP_DIRECTOR_DISCORD_ID=

# Notifications log to the journal while this is empty.
#DISCORD_WEBHOOK_URL_FILE=/run/secrets/app/discord-webhook-url
# Optional bot token for officer invitation DMs (separate from OAuth and the webhook).
#DISCORD_BOT_TOKEN_FILE=/run/secrets/app/discord-bot-token

# Optional SMTP delivery for calendar invitations and Launchpad invites.
# Without SMTP_HOST, Launchpad invites return copyable links instead.
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME_FILE=/run/secrets/app/smtp-username
#SMTP_PASSWORD_FILE=/run/secrets/app/smtp-password
#SMTP_FROM=

# Google OAuth client: per-officer calendar sync, the org calendar, and the Google
# account the dashboard stores files as (connected by an owner in Settings → Google Drive).
# Redirect URIs: ${APP_URL}/auth/google/callback, ${APP_URL}/auth/org-google/callback
# and ${APP_URL}/auth/drive-google/callback.
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET_FILE=/run/secrets/app/google-oauth-client-secret

# Optional Cloudflare membership mirror and analytics widgets.
#CLOUDFLARE_API_TOKEN_FILE=/run/secrets/app/cloudflare-api-token
#CLOUDFLARE_ACCOUNT_ID=
#CLOUDFLARE_ZONE_ID=
#D1_DATABASE_ID=

# Files (receipts, design files): a Google Shared Drive. An owner connects a member
# Google account and picks the folder in Settings → Google Drive. Set the folder here
# instead to pin it (it then wins over Settings):
#DRIVE_ROOT_FOLDER_ID=
# Storage the daily check measures against; owners are alerted at 70 % (default 100 GB).
#DRIVE_QUOTA_BYTES=100e9
# Alternative to a connected account: a service-account key FILE (a direct
# GOOGLE_SERVICE_ACCOUNT_JSON value is refused at startup). Needs DRIVE_ROOT_FOLDER_ID.
#GOOGLE_SERVICE_ACCOUNT_JSON_FILE=/run/secrets/app/google-service-account-json
# … or local disk on a single box with no Drive (not for containers):
#RECEIPTS_DIR=/var/lib/officer-dashboard/receipts

# Agent settlement tolerance (defaults: 10 % or $25, whichever is larger).
#AGENT_SETTLEMENT_TOLERANCE_PERCENT=10
#AGENT_SETTLEMENT_TOLERANCE_CENTS=2500

# Front end: embedded in release builds. Set this to serve a directory instead.
#STATIC_DIR=/opt/officer-dashboard/web
#STATIC_FALLBACK=404.html
#STATIC_FALLBACK_STATUS=404

# Reverse proxies (systemd): trust only the proxy addresses that supply X-Forwarded-For.
# Compose sets TRUSTED_PROXIES itself and ignores a value here.
#TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ── Containers (compose.cloudflare.yml) ───────────────────────────────────────────────
# Backup credentials belong only in backup.env and secrets/backup, never here.
# Optional retention and off-box copy for the systemd backup timer.
#KEEP=30
# BACKUP_REMOTE is an executable hook receiving the encrypted path as one argument.
#BACKUP_REMOTE=

# Optional Access JWT defense in depth; set ALL THREE to enable. Bare hostname, not a URL.
# Browser paths use AUD; /api/ingest and /api/agent use SERVICE_AUD.
# OAuth discovery/registration/token, MCP and health are exempt.
# Existing dashboard sessions and bearer tokens remain required.
#CLOUDFLARE_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
#CLOUDFLARE_ACCESS_AUD=your-browser-application-audience
#CLOUDFLARE_ACCESS_SERVICE_AUD=your-service-application-audience

# Systemd backup script only (required; not read by the container app):
#BACKUP_DIR=/var/lib/officer-dashboard/backups
#BACKUP_AGE_RECIPIENT=age1...
