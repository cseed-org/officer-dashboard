# /etc/officer-dashboard/env — secrets and settings for the systemd unit (mode 0640).
APP_URL=https://officers.cseed.co

# Discord OAuth2 app. Redirect URI: ${APP_URL}/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Initial dashboard owner, provisioned at server start only while no owner exists.
# Fill these in for deployment; ownership transfers override this configuration.
BOOTSTRAP_OWNER_DISCORD_ID=
BOOTSTRAP_OWNER_NAME=
# Deprecated ID alias (BOOTSTRAP_OWNER_DISCORD_ID takes precedence):
#BOOTSTRAP_DIRECTOR_DISCORD_ID=

# Notifications log to the journal while this is empty.
DISCORD_WEBHOOK_URL=

# Receipts: Google Drive shared drive (service account) …
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_ROOT_FOLDER_ID=
# … or local disk on a single box with no Drive account (not for containers):
#RECEIPTS_DIR=/var/lib/officer-dashboard/receipts

# Agent settlement tolerance (defaults: 10 % or $25, whichever is larger).
#AGENT_SETTLEMENT_TOLERANCE_PERCENT=10
#AGENT_SETTLEMENT_TOLERANCE_CENTS=2500

# Front end: embedded in release builds. Set this to serve a directory instead.
#STATIC_DIR=/opt/officer-dashboard/web
