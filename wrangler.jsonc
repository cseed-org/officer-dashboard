{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cseed-officer-dashboard",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cseed-officer-dashboard",
      // Replace with the id printed by `wrangler d1 create cseed-officer-dashboard`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Non-secret config. Secrets (DISCORD_CLIENT_SECRET, ...) are set with `wrangler secret put`.
  "vars": {
    "APP_URL": "https://officers.cseed.co"
  }
}
