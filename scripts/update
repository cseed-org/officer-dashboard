#!/usr/bin/env python3
"""Poll approved :prod and update one Docker Compose host. Linux, Python 3.11+."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import urllib.request


def run(args, env=None):
    # Capture output: compose may echo configuration; never include it in Discord/errors.
    return subprocess.run(args, check=True, text=True, capture_output=True, env=env).stdout.strip()


def notify(message, settings):
    print(message)
    url = settings.get('DISCORD_WEBHOOK_URL')
    if settings.get('DISCORD_WEBHOOK_URL_FILE'):
        try:
            name = Path(settings['DISCORD_WEBHOOK_URL_FILE']).name
            url = (Path.cwd() / 'secrets/app' / name).read_text().strip()
        except OSError:
            print('Cannot read host Discord webhook file', file=sys.stderr)
    if url:
        try:
            req = urllib.request.Request(url, json.dumps({'content': message}).encode(),
                {'Content-Type': 'application/json', 'User-Agent': 'dashboard-update'})
            urllib.request.urlopen(req, timeout=20).close()
        except Exception:
            print('Discord notification failed', file=sys.stderr)


def dotenv(path):
    if not path.exists():
        return {}
    return dict(line.split('=', 1) for line in path.read_text().splitlines()
                if line and not line.startswith('#') and '=' in line)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--deploy-dir', default=str(Path(__file__).resolve().parents[1] / 'server/deploy'))
    parser.add_argument('--image', help='explicit immutable image for isolated rehearsal')
    parser.add_argument('--retry', action='store_true', help='retry a previously rolled-back digest')
    args = parser.parse_args()
    deploy = Path(args.deploy_dir).resolve()
    os.chdir(deploy)
    os.umask(0o077)
    settings = dotenv(deploy / 'dashboard.env')
    lock = open(deploy / '.update.lock', 'a')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return
    state = deploy / 'prod-image.env'
    if not state.exists():
        raise ValueError('initialize prod-image.env with the currently running immutable image')
    previous = dotenv(state)['DASHBOARD_IMAGE']
    if not re.fullmatch(r'[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}', previous):
        raise ValueError('previous image must be pinned by digest')
    image_name = 'ghcr.io/cseed-org/officer-dashboard'
    if args.image:
        candidate = args.image
    else:
        inspection = json.loads(run(['docker', 'buildx', 'imagetools', 'inspect', image_name + ':prod', '--format', '{{json .Manifest}}']))
        candidate = image_name + '@' + inspection['digest']
    if not re.fullmatch(r'[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}', candidate):
        raise ValueError('candidate must be pinned by digest')
    if candidate == previous:
        return
    rejected = deploy / 'rejected-prod-image'
    if not args.retry and rejected.exists() and rejected.read_text().strip() == candidate:
        return
    base = ['docker', 'compose', '--env-file', str(deploy / '.env'), '--env-file', str(state), '-f', str(deploy / 'compose.cloudflare.yml')]
    def compose(*arguments, image=None):
        env = dict(os.environ, DASHBOARD_IMAGE=image or previous)
        return run(base + list(arguments), env)
    def backup_tool(command, image=None):
        return compose('run', '--rm', '--no-deps', '--entrypoint', '/app/dashboard-backup', 'backup', command, image=image)
    def health(image):
        for _ in range(30):
            try:
                compose('exec', '-T', 'dashboard', '/app/dashboard', 'healthcheck', image=image)
                return
            except subprocess.CalledProcessError:
                time.sleep(2)
        raise RuntimeError('health check failed')
    # The previous image must include the backup client; bootstrap upgrades are manual.
    stopped = swapped = checkpoint = False
    snapshot = ''
    try:
        compose('pull', 'dashboard', image=candidate)
        compose('stop', 'dashboard', 'backup')
        stopped = True
        snapshot = backup_tool('backup')
        # Preserve the stopped original until success. Temporary copies stay in the data
        # volume, with its normal SQLite access controls; no decryption key is on the host.
        backup_tool('checkpoint')
        checkpoint = True
        compose('run', '--rm', '--no-deps', '-e', 'DB_PATH=/data/.migration-check.db', '--entrypoint', '/app/dashboard', 'dashboard', 'migrate', image=candidate)
        swapped = True  # app startup can migrate even when compose up fails
        compose('up', '-d', '--no-deps', 'dashboard', image=candidate)
        health(candidate)
        compose('up', '-d', '--no-deps', 'backup', image=candidate)
        temporary = state.with_suffix('.next')
        temporary.write_text('DASHBOARD_IMAGE=' + candidate + '\n')
        os.replace(temporary, state)
        # The update is committed. Cleanup failure must not initiate a rollback after
        # its checkpoint may already have been removed.
        try:
            rejected.unlink(missing_ok=True)
            backup_tool('cleanup', image=candidate)
        except Exception:
            notify('Production is healthy; temporary update file cleanup needs attention.', settings)
        notify('Production update succeeded: ' + candidate, settings)
    except Exception:
        if stopped:
            try:
                compose('stop', 'dashboard', 'backup', image=candidate)
                if checkpoint and swapped:
                    backup_tool('rollback')
                compose('up', '-d', '--no-deps', 'dashboard', 'backup')
                health(previous)
                state.write_text('DASHBOARD_IMAGE=' + previous + '\n')
                rejected.write_text(candidate + '\n')
                notify('Production update failed; previous image and pre-update database restored. Snapshot: ' + snapshot, settings)
            except Exception:
                notify('Production rollback FAILED; operator recovery required. Retain /data/.update-before.db and the D1 snapshot.', settings)
                raise
        else:
            notify('Production update failed before stopping the application.', settings)
        raise


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('Update failed: ' + type(error).__name__, file=sys.stderr)
        sys.exit(1)
