---
import AppLayout from '../../layouts/AppLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import EventsView from '../../ui/islands/EventsView';

const w = Astro.url.searchParams.get('when');
const when = w === 'upcoming' || w === 'past' ? w : 'all';
const q = Astro.url.searchParams.get('q') ?? '';
---

<AppLayout title="events">
  <PageTitle title="events" sub="Registrations, check-ins and reflection surveys, from Luma exports.">
    <a class="btn" href="/events/import">import from Luma</a>
  </PageTitle>
  <EventsView client:load initialWhen={when} initialQ={q} />
</AppLayout>
