---
import AppLayout from '../../layouts/AppLayout.astro';
import RequestDetailView from '../../ui/islands/RequestDetailView';

const id = Astro.params.id!;
const user = Astro.locals.user!;
---

<AppLayout title="request">
  <RequestDetailView
    client:load
    id={id}
    meId={user.id}
    created={Astro.url.searchParams.get('created')}
    uploadFailed={Number(Astro.url.searchParams.get('uploadFailed') ?? 0) || 0}
  />
</AppLayout>
