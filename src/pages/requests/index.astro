---
import AppLayout from '../../layouts/AppLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import RequestsView from '../../ui/islands/RequestsView';
import { PurchaseRequestsListQuery } from '../../core/contracts';

const user = Astro.locals.user!;
const q = PurchaseRequestsListQuery.pick({ scope: true, status: true }).safeParse(Object.fromEntries(Astro.url.searchParams));
const scope = q.success ? q.data.scope : 'mine';
const status = q.success && q.data.status ? q.data.status : 'any';
---

<AppLayout title="requests">
  <PageTitle title="purchase requests" sub="Ask for club purchases or reimbursements. A director approves each one.">
    <a class="btn btn--highlight" href="/requests/new">new request</a>
  </PageTitle>
  <RequestsView client:load initialScope={scope} initialStatus={status} isDirector={user.role === 'director'} />
</AppLayout>
