---
import AppLayout from '../../layouts/AppLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import FinanceView from '../../ui/islands/FinanceView';
import { fiscalYearFor } from '../../core/fiscal';

const user = Astro.locals.user!;
const isDirector = user.role === 'director';
const fy = fiscalYearFor(new Date().toISOString().slice(0, 10));
---

<AppLayout title="finance">
  <PageTitle
    title="finance"
    sub={isDirector
      ? 'Budget, funds and the nonprofit statements (ASC 958). Not tax advice: have the CPA review before filing.'
      : 'Where the budget stands and what each fund has left.'}
  />
  <FinanceView client:load isDirector={isDirector} fiscalYear={fy} initialTab={Astro.url.searchParams.get('tab')} />
</AppLayout>
