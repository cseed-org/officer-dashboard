---
import AppLayout from '../layouts/AppLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import OverviewView from '../ui/islands/OverviewView';

const name = Astro.locals.user?.name.split(' ')[0];
---

<AppLayout title="overview">
  <PageTitle title="overview" eyebrow={name ? `hi, ${name}` : undefined}>
    <a class="btn btn--highlight" href="/requests/new">new purchase request</a>
  </PageTitle>
  <OverviewView client:load />
</AppLayout>
