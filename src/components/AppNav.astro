---
import type { CurrentUser } from '../core/contracts';
import { hasRole } from '../core/auth';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  user: CurrentUser;
}
const { user } = Astro.props;
const path = Astro.url.pathname;

const items = [
  { label: 'overview', href: '/', icon: 'M3 12l9-8 9 8M5 10v10h14V10' },
  { label: 'events', href: '/events', icon: 'M4 6h16v14H4zM4 10h16M8 3v5M16 3v5' },
  { label: 'requests', href: '/requests', icon: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h7' },
  { label: 'finance', href: '/finance', icon: 'M4 20V10M10 20V4M16 20v-7M22 20H2' },
  ...(hasRole(user.role, 'director')
    ? [{ label: 'admin', href: '/admin/users', icon: 'M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z' }]
    : []),
];
/** Active when the path is in the item's top-level section (/admin/tokens → admin). */
const isActive = (href: string) => {
  const base = href === '/' ? '/' : `/${href.split('/')[1]}`;
  return base === '/' ? path === '/' : path === base || path.startsWith(`${base}/`);
};
---

<header class="nav-bar" data-nav>
  <a class="nav-bar-mark" href="/" aria-label="cseed officers, overview">
    <img class="nav-bar-logo nav-bar-logo--ink" src="/images/cseed-logo.png" alt="" width="640" height="147" />
    <img class="nav-bar-logo nav-bar-logo--white" src="/images/cseed-logo-white.png" alt="" width="640" height="147" />
    <span class="nav-bar-sub">officers</span>
  </a>

  <nav class="nav-bar-items" aria-label="Main">
    {
      items.map((item) => (
        <a class:list={['nav-bar-link', { 'is-active': isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="nav-bar-tools">
    <ThemeToggle />
    <form method="post" action="/auth/logout" class="nav-bar-account">
      <span class="nav-bar-user" title={`${user.name} · ${user.role}`}>{user.name}</span>
      <button type="submit" class="nav-bar-signout">sign out</button>
    </form>
  </div>
</header>

<nav class="tab-bar" aria-label="Main (mobile)">
  {
    items.map((item) => (
      <a class:list={['tab-bar-link', { 'is-active': isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d={item.icon} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" stroke-linecap="round" />
        </svg>
        <span>{item.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: var(--nav-h);
    padding: 0 var(--gutter);
    background: var(--surface-page);
    border-bottom: var(--rule-strong) solid var(--rule);
  }
  .nav-bar-mark {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex: none;
    text-decoration: none;
    color: var(--text-body);
  }
  .nav-bar-logo {
    display: block;
    width: 84px;
    height: auto;
    align-self: center;
  }
  .nav-bar-logo--white {
    display: none;
  }
  .nav-bar-sub {
    font-family: var(--font-display);
    font-size: 1.375rem;
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }
  .nav-bar-items {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    margin-left: auto;
    min-width: 0;
  }
  .nav-bar-link {
    position: relative;
    font-family: var(--font-body);
    font-weight: var(--weight-body);
    font-size: var(--size-nav);
    color: var(--text-body);
    text-decoration: none;
    white-space: nowrap;
    padding: 0 6px;
    margin: 0 -6px;
    transition: opacity var(--dur-hover) var(--ease-soft);
  }
  /* the yellow marker from the landing site's "join" link */
  .nav-bar-link.is-active {
    color: var(--text-on-highlight);
    background: linear-gradient(transparent 45%, var(--highlight) 45%, var(--highlight) 92%, transparent 92%);
  }
  @media (hover: hover) {
    .nav-bar-items:has(.nav-bar-link:hover) .nav-bar-link:not(:hover) {
      opacity: 0.45;
    }
  }
  .nav-bar-tools {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex: none;
  }
  .nav-bar-account {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
  }
  .nav-bar-user {
    font-size: var(--size-sm);
    color: var(--text-muted);
    max-width: 14ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .nav-bar-signout {
    font: inherit;
    font-size: var(--size-sm);
    color: var(--text-link);
    background: none;
    border: 0;
    padding: var(--space-2) 0;
    min-height: 44px;
    text-decoration: underline;
    text-decoration-thickness: var(--rule-hairline);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .tab-bar {
    display: none;
  }

  /* Tablet: drop the name, keep inline links. */
  @media (max-width: 1023px) {
    .nav-bar-user {
      display: none;
    }
  }

  /* Phone: compact top bar + bottom tab bar. */
  @media (max-width: 639px) {
    .nav-bar-items {
      display: none;
    }
    .nav-bar-tools {
      margin-left: auto;
    }
    .nav-bar-logo {
      width: 72px;
    }
    .nav-bar-sub {
      font-size: 1.125rem;
    }
    .tab-bar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 10;
      display: flex;
      height: calc(var(--tabbar-h) + env(safe-area-inset-bottom));
      padding-bottom: env(safe-area-inset-bottom);
      background: var(--surface-page);
      border-top: var(--rule-strong) solid var(--rule);
    }
    .tab-bar-link {
      flex: 1 1 0;
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 2px;
      font-size: 0.6875rem;
      color: var(--text-muted);
      text-decoration: none;
    }
    .tab-bar-link.is-active {
      color: var(--text-body);
      box-shadow: inset 0 3px 0 var(--highlight);
    }
  }
</style>

<style is:global>
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .nav-bar-logo--ink { display: none; }
    :root:not([data-theme='light']) .nav-bar-logo--white { display: block; }
    :root:not([data-theme='light']) .nav-bar-link.is-active { background: var(--highlight); }
  }
  :root[data-theme='dark'] .nav-bar-logo--ink { display: none; }
  /* Dark: the half-height marker would leave the top of the ink letters on the dark ground
     (unreadable), so the yellow fills the whole link instead. */
  :root[data-theme='dark'] .nav-bar-link.is-active { background: var(--highlight); }
  :root[data-theme='dark'] .nav-bar-logo--white { display: block; }
</style>
