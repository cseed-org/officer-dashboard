---
import '../styles/global.css';
import AppNav from '../components/AppNav.astro';

interface Props {
  title: string;
  /** Pages without the app shell (login, errors when signed out). */
  bare?: boolean;
}
const { title, bare = false } = Astro.props;
const user = Astro.locals.user;
const showNav = !bare && user;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#e4e3e1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    <title>{title} · cseed officers</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Same Google Fonts request as cseed.co's BaseLayout. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Poppins:ital,wght@0,200;0,300;0,400;1,200&family=Ubuntu:wght@400;500;700&family=Anonymous+Pro:ital,wght@0,400;0,700;1,400&family=Shadows+Into+Light+Two&display=swap"
    />
    <!-- Apply a saved theme before first paint. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class:list={{ 'has-nav': showNav }}>
    <a class="skip-link" href="#main">skip to content</a>
    {showNav && <AppNav user={user} />}
    <main class="page" id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<style>
  .page {
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: var(--space-6) var(--gutter) var(--space-8);
  }
  @media (max-width: 639px) {
    .has-nav .page {
      padding-bottom: calc(var(--tabbar-h) + env(safe-area-inset-bottom) + var(--space-6));
    }
  }
</style>
