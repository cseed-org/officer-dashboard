{
  "name": "cseed-officer-dashboard",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/ensure-dev-vars.mjs && astro dev",
    "build": "astro build && node scripts/check-build.mjs",
    "preview": "astro build && wrangler dev",
    "typecheck": "wrangler types && astro check && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "tsx scripts/seed.ts > .wrangler/seed.sql && wrangler d1 execute DB --local --file .wrangler/seed.sql",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed:local",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/preact": "^6.1.1",
    "arctic": "^3.7.0",
    "astro": "^7.4.4",
    "drizzle-orm": "^0.45.4",
    "preact": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.1-beta",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  },
  "private": true
}
