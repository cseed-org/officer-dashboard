---
import AppLayout from '../layouts/AppLayout.astro';
const MESSAGES = {
  not_allowlisted: 'That Discord account is not on the officer list. Ask a director to add you.',
  inactive: 'Your officer account is deactivated. Ask a director to restore it.',
  state: 'The sign-in link expired. Try again.',
  discord: 'Discord sign-in failed. Try again.',
  invite_unavailable: 'That invitation has expired or is for a different Discord account. Ask the person who invited you for a new link.',
};
// ?next= and ?error= are read in the browser: the page is static. `next` must resolve to
// this origin (new URL check; "//x" and backslash forms are refused), as in src/lib/url.ts.
const SCRIPT = `(function(){function safe(r){if(!r||r.charAt(0)!=='/'||r.charAt(1)==='/'||r.indexOf('\\\\')>=0)return'/';try{var u=new URL(r,location.origin);return u.origin===location.origin?u.pathname+u.search+u.hash:'/'}catch(e){return'/'}}var p=new URLSearchParams(location.search),n=safe(p.get('next'));var q=n==='/'?'':'next='+encodeURIComponent(n),iv=p.get('invite');if(iv){var note=document.querySelector('[data-invite-note]');if(note)note.hidden=false;var intro=document.querySelector('[data-login-intro]');if(intro)intro.hidden=true}document.querySelectorAll('[data-auth-link]').forEach(function(a){var u=new URL(a.getAttribute('href'),location.href);if(q)u.searchParams.set('next',n);if(iv)u.searchParams.set('invite',iv);a.setAttribute('href',u.pathname+u.search)});var e=p.get('error'),m=${JSON.stringify(MESSAGES)},el=document.querySelector('[data-login-error]');if(e&&el){el.textContent=m[e]||'Sign-in failed.';el.hidden=false}var dk=p.get('key'),tpl=document.querySelector('template[data-dev-panel]');if(tpl)fetch('/auth/dev/info'+(dk?'?key='+encodeURIComponent(dk):''),{credentials:'same-origin',cache:'no-store'}).then(function(r){return r.ok?r.json():null}).then(function(i){if(!i||i.enabled!==true||i.authorized!==true)return;var panel=tpl.content.firstElementChild.cloneNode(true);panel.querySelectorAll('[data-dev-login]').forEach(function(a){var u=new URL('/auth/dev',location.href);u.searchParams.set('as',a.getAttribute('data-dev-login'));if(q)u.searchParams.set('next',n);if(dk)u.searchParams.set('key',dk);a.setAttribute('href',u.pathname+u.search)});tpl.replaceWith(panel);if(dk&&history.replaceState){p.delete('key');var s=p.toString();history.replaceState(null,'',location.pathname+(s?'?'+s:'')+location.hash)}}).catch(function(){});fetch('/api/me',{credentials:'same-origin'}).then(function(r){if(r.ok)location.replace(n);else try{localStorage.removeItem('cseed-role')}catch(e){}}).catch(function(){})})();`;
---

<AppLayout title="Sign in" bare>
  <section class="auth-card" aria-labelledby="login-h">
    <span class="wordmark-mark" aria-hidden="true">C</span>
    <h1 id="login-h">CSEED officers</h1>
    <p class="notice notice--negative" role="alert" data-login-error hidden></p>
    <p class="muted" data-login-intro>Events, purchase requests and the books. Sign in with the Discord account a director added.</p>
    <p class="notice" data-invite-note hidden>You've been invited to the CSEED officer team. Sign in with the Discord account the invite was sent to, and we'll get you set up.</p>
    <a class="btn btn--primary btn--block" href="/auth/login" data-auth-link data-login>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
        ><path
          fill="currentColor"
          d="M20.3 4.4A19.6 19.6 0 0 0 15.4 3l-.6 1.3a18 18 0 0 0-5.6 0L8.6 3a19.5 19.5 0 0 0-4.9 1.5C.6 9.1-.3 13.6.1 18.1a19.8 19.8 0 0 0 6 3l1.3-2a12.7 12.7 0 0 1-2-1l.5-.4a14 14 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1l1.3 2a19.7 19.7 0 0 0 6-3c.5-5.2-.9-9.7-3.6-13.7ZM8 15.4c-1.2 0-2.2-1.1-2.2-2.4S6.8 10.6 8 10.6s2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"
        ></path></svg
      >
      Sign in with Discord
    </a>
    {/* Developer mode: only a dev build with DEV_AUTH=1 answers /auth/dev/info (and, with
         DEV_AUTH_KEY set, only for a visitor holding the key), so production never shows this. */}
    <template data-dev-panel>
      <section class="notice notice--attention dev-panel" aria-labelledby="dev-panel-h" data-dev-panel-shown>
        <h2 id="dev-panel-h" class="dev-panel-title">Developer mode</h2>
        <p class="small muted flush">Skip Discord and continue as</p>
        <div class="dev-panel-roles">
          <a class="btn btn--block" href="/auth/dev?as=leadership" data-dev-login="leadership">Leadership</a>
          <a class="btn btn--block" href="/auth/dev?as=director" data-dev-login="director">Director</a>
          <a class="btn btn--block" href="/auth/dev?as=officer" data-dev-login="officer">Officer</a>
        </div>
        <p class="small muted flush">This is a test build. Sign-ins here skip Discord and are not available in production.</p>
      </section>
    </template>
  </section>
  <script is:inline set:html={SCRIPT} />
</AppLayout>
