---
import AppLayout from '../layouts/AppLayout.astro';
const dev = import.meta.env.DEV;
const MESSAGES = {
  not_allowlisted: 'That Discord account is not on the officer list. Ask a director to add you.',
  inactive: 'Your officer account is deactivated. Ask a director to restore it.',
  state: 'The sign-in link expired. Try again.',
  discord: 'Discord sign-in failed. Try again.',
};
// ?next= and ?error= are read in the browser: the page is static.
const SCRIPT = `(function(){var p=new URLSearchParams(location.search),n=p.get('next')||'/';if(!/^\\/(?!\\/)/.test(n))n='/';var q=n==='/'?'':'next='+encodeURIComponent(n);document.querySelectorAll('[data-auth-link]').forEach(function(a){var u=new URL(a.getAttribute('href'),location.href);if(q)u.searchParams.set('next',n);a.setAttribute('href',u.pathname+u.search)});var e=p.get('error'),m=${JSON.stringify(MESSAGES)},el=document.querySelector('[data-login-error]');if(e&&el){el.textContent=m[e]||'Sign-in failed.';el.hidden=false}fetch('/api/me',{credentials:'same-origin'}).then(function(r){if(r.ok)location.replace(n)}).catch(function(){})})();`;
---

<AppLayout title="Sign in" bare>
  <section class="auth-card" aria-labelledby="login-h">
    <span class="wordmark-mark" aria-hidden="true">C</span>
    <h1 id="login-h">CSEED officers</h1>
    <p class="notice notice--negative" role="alert" data-login-error hidden></p>
    <p class="muted">Events, purchase requests and the books. Sign in with the Discord account a director added.</p>
    <a class="btn btn--primary btn--block" href="/auth/login" data-auth-link data-login>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"
        ><path
          fill="currentColor"
          d="M20.3 4.4A19.6 19.6 0 0 0 15.4 3l-.6 1.3a18 18 0 0 0-5.6 0L8.6 3a19.5 19.5 0 0 0-4.9 1.5C.6 9.1-.3 13.6.1 18.1a19.8 19.8 0 0 0 6 3l1.3-2a12.7 12.7 0 0 1-2-1l.5-.4a14 14 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1l1.3 2a19.7 19.7 0 0 0 6-3c.5-5.2-.9-9.7-3.6-13.7ZM8 15.4c-1.2 0-2.2-1.1-2.2-2.4S6.8 10.6 8 10.6s2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"
        ></path></svg
      >
      Sign in with Discord
    </a>
    {
      dev && (
        <p class="small muted login-dev">
          dev:{' '}
          <a href="/auth/dev?as=director" data-auth-link data-dev-login="director">
            director
          </a>{' '}
          /{' '}
          <a href="/auth/dev?as=officer" data-auth-link data-dev-login="officer">
            officer
          </a>
        </p>
      )
    }
  </section>
  <script is:inline set:html={SCRIPT} />
</AppLayout>
