{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "0.15.0",
      "include-component-in-tag": false,
      "extra-files": [
        { "type": "json", "path": "package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "package-lock.json", "jsonpath": "$.packages[''].version" },
        { "type": "json", "path": "web/package-lock.json", "jsonpath": "$.version" },
        { "type": "json", "path": "web/package-lock.json", "jsonpath": "$.packages[''].version" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Bug Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "deps", "section": "Dependencies" },
        { "type": "deps-dev", "section": "Development Dependencies", "hidden": true },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "chore", "section": "Miscellaneous", "hidden": true },
        { "type": "ci", "section": "Continuous Integration", "hidden": true },
        { "type": "build", "section": "Build System", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "refactor", "section": "Code Refactoring", "hidden": true },
        { "type": "style", "section": "Styles", "hidden": true },
        { "type": "revert", "section": "Reverts", "hidden": true }
      ]
    }
  }
}
